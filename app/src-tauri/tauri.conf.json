{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dwarven Realms Planner",
  "version": "0.1.0",
  "identifier": "fr.mat.drplanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dwarven Realms Planner",
        "width": 1480,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Dwarven Realms Planner contributors",
    "copyright": "MIT OR Apache-2.0. Not affiliated with Crater Studios.",
    "category": "Utility",
    "shortDescription": "Build planner for Dwarven Realms",
    "longDescription": "Build planner for Dwarven Realms: stats, damage and skill tree computed with the game's own code, from your own installation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}